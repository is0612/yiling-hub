  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "element-plus": "^2.11.0",
    "nuxt": "^4.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@element-plus/nuxt": "^1.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
