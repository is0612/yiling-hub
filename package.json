{
  "name": "yiling-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "nuxt prepare && prisma generate",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "dev": "nuxt dev --open",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "lint": "eslint app server scripts nuxt.config.ts prisma.config.ts",
    "check:sfc": "node scripts/check-sfc.mjs",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.server.json --noEmit",
    "db:seed:dev": "tsx scripts/seed-dev-user.ts",
    "scheduler:run": "tsx scripts/run-memory-scheduler.ts",
    "scheduler:watch": "tsx scripts/run-memory-scheduler.ts --watch",
    "test:scheduler": "tsx scripts/test-memory-scheduler.ts",
    "test:scheduler-db": "tsx scripts/test-memory-scheduler-db.ts",
    "test:memory-ai": "tsx scripts/test-memory-ai.ts",
    "test:memory-ai-request": "tsx scripts/test-memory-ai-request.ts",
    "worker:run": "tsx scripts/run-memory-worker.ts",
    "worker:watch": "tsx scripts/run-memory-worker.ts --watch",
    "onebot:run": "tsx scripts/run-onebot-adapter.ts",
    "onebot:stack": "tsx scripts/start-qq-stack.ts",
    "proactive:run": "tsx scripts/run-proactive.ts",
    "bili:run": "tsx scripts/run-bili-adapter.ts",
    "bili:import": "tsx scripts/import-bili-desk.ts",
    "test:memory-retrieval": "tsx scripts/test-memory-retrieval.ts",
    "test:memory-budget": "tsx scripts/test-memory-budget.ts",
    "test:model-usage": "tsx scripts/test-model-usage.ts",
    "test:chat-model-config": "tsx scripts/test-chat-model-config.ts",
    "test:chat-reply": "tsx scripts/test-chat-reply.ts",
    "test:chat-private-memory": "tsx scripts/test-chat-private-memory.ts",
    "test:chat-speaker-context": "tsx scripts/test-chat-speaker-context.ts",
    "test:chat-private-memory-db": "tsx scripts/test-chat-private-memory-db.ts",
    "test:chat-request-idempotency-db": "tsx scripts/test-chat-request-idempotency-db.ts",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:auth-db": "tsx scripts/test-auth-db.ts",
    "test:onebot": "tsx scripts/test-onebot-adapter.ts",
    "test:onebot-faces": "tsx scripts/test-onebot-faces.ts",
    "test:image-understanding": "tsx scripts/test-image-understanding.ts",
    "probe:vision": "tsx scripts/probe-vision.ts",
    "test:onebot-supervise": "tsx scripts/test-onebot-supervise.ts",
    "test:onebot-runner": "tsx scripts/test-onebot-runner.ts",
    "test:onebot-announcement": "tsx scripts/test-onebot-group-announcement.ts",
    "test:onebot-bili-run": "tsx scripts/test-onebot-bili-run.ts",
    "test:onebot-group-chat": "tsx scripts/test-onebot-group-chat.ts",
    "test:qq-chain": "tsx scripts/test-qq-channel-chain.ts",
    "test:proactive": "tsx scripts/test-proactive.ts",
    "test:proactive-db": "tsx scripts/test-proactive-db.ts",
    "test:bili-runner": "tsx scripts/test-bili-runner.ts",
    "test:bili-schema": "tsx scripts/test-bili-schema-catalog.ts",
    "test:bili-db": "tsx scripts/test-bili-db.ts",
    "test:bili-duty": "tsx scripts/test-bili-duty.ts",
    "test:bili-llm": "tsx scripts/test-bili-llm.ts",
    "test:bili-cards": "tsx scripts/test-bili-cards.ts",
    "test:identity": "tsx scripts/test-identity.ts",
    "verify:local": "yarn run db:validate && yarn run db:generate && yarn nuxt prepare && yarn run check:sfc && yarn run typecheck && yarn run test:scheduler && yarn run test:scheduler-db && yarn run test:memory-ai && yarn run test:memory-ai-request && yarn run test:memory-retrieval && yarn run test:memory-budget && yarn run test:model-usage && yarn run test:chat-model-config && yarn run test:chat-reply && yarn run test:chat-private-memory && yarn run test:chat-speaker-context && yarn run test:chat-private-memory-db && yarn run test:chat-request-idempotency-db && yarn run test:auth && yarn run test:auth-db && yarn run test:identity && yarn run test:onebot && yarn run test:onebot-faces && yarn run test:image-understanding && yarn run test:onebot-supervise && yarn run test:onebot-runner && yarn run test:onebot-announcement && yarn run test:onebot-bili-run && yarn run test:onebot-group-chat && yarn run test:qq-chain && yarn run test:proactive && yarn run test:proactive-db && yarn run test:bili-cards && yarn run test:bili-llm && yarn run test:bili-duty && yarn run test:bili-runner && yarn run test:bili-schema && yarn run test:bili-db && yarn run lint && yarn run build"
