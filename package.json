{
  "name": "yiling-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "prisma generate && nuxt prepare",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "lint": "eslint app server scripts nuxt.config.ts prisma.config.ts",
    "typecheck": "nuxt typecheck",
    "db:seed:dev": "tsx scripts/seed-dev-user.ts",
    "scheduler:run": "tsx scripts/run-memory-scheduler.ts",
    "scheduler:watch": "tsx scripts/run-memory-scheduler.ts --watch",
    "test:scheduler": "tsx scripts/test-memory-scheduler.ts",
    "test:scheduler-db": "tsx scripts/test-memory-scheduler-db.ts",
    "test:memory-ai": "tsx scripts/test-memory-ai.ts",
    "worker:run": "tsx scripts/run-memory-worker.ts",
    "worker:watch": "tsx scripts/run-memory-worker.ts --watch",
    "test:memory-retrieval": "tsx scripts/test-memory-retrieval.ts",
    "test:chat-model-config": "tsx scripts/test-chat-model-config.ts",
    "test:chat-reply": "tsx scripts/test-chat-reply.ts",
    "verify:local": "yarn run db:validate && yarn run db:generate && yarn nuxt prepare && yarn run typecheck && yarn run test:scheduler && yarn run test:scheduler-db && yarn run test:memory-ai && yarn run test:memory-retrieval && yarn run test:chat-model-config && yarn run test:chat-reply && yarn run lint && yarn run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "element-plus": "^2.11.0",
    "nuxt": "^4.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@element-plus/nuxt": "^1.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
