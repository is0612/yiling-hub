# 本地开发模板。复制为 .env 后修改；不要提交真实 .env。
# 仅限本地开发，不要在公开服务中使用这里的示例凭据。
POSTGRES_DB=yiling_hub
POSTGRES_USER=yiling_hub
POSTGRES_PASSWORD=replace_with_local_dev_password
POSTGRES_PORT=5432

# 保持用户名、密码、端口、数据库名与上方配置一致。
# 如果密码含 URI 特殊字符，请对连接串中的用户名/密码进行 URL 编码。
DATABASE_URL=postgresql://yiling_hub:replace_with_local_dev_password@localhost:5432/yiling_hub?schema=public

# Phase 2 本地开发 API 开关：仅开发模式 + localhost 可访问，生产环境会拒绝请求。
YILING_LOCAL_API_ENABLED=true
DEV_OWNER_ID=00000000-0000-4000-8000-000000000001
DEV_OWNER_USERNAME=local-dev
DEV_OWNER_PASSWORD=replace_with_a_local_only_password

# 管理员登录会话有效期（小时，1–720，默认 12）。会话保存在数据库，浏览器只持有 HttpOnly Cookie。
AUTH_SESSION_TTL_HOURS=12
# 本地开发便捷开关：true 时，未登录且通过 localhost 访问会使用 DEV_OWNER_ID 身份；
# 设为 false 可强制本地也必须登录（用于验证真实登录流程）。生产构建始终不使用该回退。
YILING_ALLOW_DEV_OWNER_BYPASS=true
# 生产环境通过 HTTPS 访问时设为 true，让会话 Cookie 带 Secure 属性（NODE_ENV=production 时自动启用）。
YILING_COOKIE_SECURE=false
# 开放邮箱自助注册（/api/auth/register）。默认 false（关闭），部署到服务器后再设为 true 开放。
# 注册不发送验证邮件——本部署默认无 SMTP，邮箱仅作为登录标识。
YILING_ALLOW_REGISTRATION=false

# QQ 官方机器人渠道（Phase 5）。AppID / AppSecret 在网页「渠道管理」里创建连接时填写，
# 加密保存在数据库；下方三个端点默认官方值，本地联调可指向 mock（见 scripts/mock-qq-gateway.mjs）。
QQ_TOKEN_URL=https://bots.qq.com/app/getAppAccessToken
QQ_API_BASE_URL=https://api.sgroup.qq.com
QQ_GATEWAY_URL=wss://api.sgroup.qq.com/websocket

# 可选的服务端默认模型配置。通常直接在网页“AI 对话 → 模型参数”中填写每个角色的 API 地址、Key 和模型。
# 此处留空时，若角色已在网页配置 API 则仍可正常使用；若填写，则作为未单独配置角色的默认回退值。
# 密钥只在服务端读取，严禁使用 NEXT_PUBLIC_ 前缀。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000

# 可选：QQ 群「看图」的视觉模型。开关在网页「系统管理 → QQ 渠道 → 角色行为 → 看群里的图」，
# 角色级、默认关；不开的话群里的图仍然只是 [图片]。
# 三项都可以留空：留空时用这个角色自己的聊天模型与 Key 读图（实测 deepseek-flash 能读图）。
# 想统一换一个更便宜/更快的视觉模型时才填 VISION_MODEL，需要时再填 BASE_URL / API_KEY；
# 也可以用角色 modelConfig.visionModel / visionApiBaseUrl 单独覆盖。
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=

# 可选：QQ 语音。两个开关都在「系统管理 → QQ 渠道 → 角色行为 → 语音」，角色级、默认关。
#   VOICE_TTS_*  她的回复发成语音条（文字 → wav → silk → record 段）
#   VOICE_ASR_*  别人发的语音条转成文字再进提示词（silk → wav → 转写）
#
# ⚠️ 语音要单独一家服务商：DeepSeek / 多数纯文本模型服务商没有 /audio/speech（直接 404）。
#    下面的默认值是硅基流动，一个 Key 同时做 TTS 与 ASR、国内直连，
#    Key 在 https://cloud.siliconflow.cn/account/ak 拿（sk- 开头）。
#    想换 OpenAI 官方：BASE_URL 用 https://api.openai.com/v1，TTS_MODEL=gpt-4o-mini-tts、
#    VOICE=nova、ASR_MODEL=whisper-1，并删掉 VOICE_TTS_SAMPLE_RATE（OpenAI 不认这个字段）。
#
# ⭐ 推荐在页面上填（角色行为 → 语音）：那里填的 Key 加密存库、优先于这里的值，
#    换服务商不必改文件也不必重启。下面这段只是「所有角色共用一家」时的服务级默认值。
#
# 地址与 Key 留空时会回落到这个角色自己的聊天地址与 Key（同服务商时能省一份配置），
# 但**显式填了 BASE_URL 却写错时不会回落** —— 那样会让人以为在用独立服务。
# ⚠️ TTS 必须要到 wav：这里没有 mp3 解码器，拿到 mp3 会退回发文字（日志 `[voice] tts 返回的不是 wav`）。
VOICE_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
VOICE_TTS_BASE_URL=https://api.siliconflow.cn/v1
VOICE_TTS_API_KEY=
# 服务商：openai（含所有兼容接口）/ minimax。留空就按 BASE_URL 里有没有 minimax 自动判断。
# 换成 MiniMax 时：BASE_URL=https://api.minimaxi.com/v1（国际站 api.minimax.io）、
#   MODEL=speech-2.5-turbo-preview、VOICE=female-shaonv / female-yujie / female-chengshu，
#   并填上 GROUP_ID（接口里叫 GroupId，页面上叫「空间 ID（GID）」：
#   个人信息 → 空间管理 → 个人空间 → 管理。它在查询参数里，不是密钥，缺了会报 GroupId 不匹配）。
VOICE_TTS_PROVIDER=
VOICE_TTS_GROUP_ID=
# 音色带模型前缀。女声 anna/bella/claire/diana，男声 alex/benjamin/charles/david。
VOICE_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:claire
VOICE_TTS_SPEED=1
# 24k 足够：最终转 24k silk，服务商默认 44100 白扛一倍体积。
VOICE_TTS_SAMPLE_RATE=24000
VOICE_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
VOICE_ASR_BASE_URL=https://api.siliconflow.cn/v1
VOICE_ASR_API_KEY=
# 留空 = 服务商自己判断语言（SenseVoice 不认 language 字段）。
VOICE_ASR_LANGUAGE=

# 可选：总览页「用量与花费」的计价。金额只是估算，实际账单以供应商为准。
# 输入分「缓存命中 / 未命中」两档（命中价见 server/utils/model-pricing.ts 的 cacheHitInput），
# DeepSeek 还会按调用时间自动区分高峰/空闲；没有缓存明细的旧记录只能按未命中价估，页面会提示偏高。
# 厂商调价或用了私有模型时，在这里覆盖：单位是「每百万 token」，键名大小写不敏感、支持包含匹配。
# 例：MODEL_PRICING={"my-relay/deepseek-flash":{"input":2,"output":6,"cacheHitInput":0.1},"gpt-4o-mini":{"currency":"USD","input":0.15,"output":0.6}}
MODEL_PRICING=
# 美元计价模型折算人民币的汇率；不填按 7.2。
USD_CNY_RATE=7.2
