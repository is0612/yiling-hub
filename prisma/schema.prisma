// Yiling Hub data model.
// This schema is the intended Phase 0 contract. Run Prisma validation and migration
// generation locally before applying it to any database.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Two tiers only: one ADMIN who manages accounts, and USERs who own their own characters.
enum UserRole {
  ADMIN
  USER
}

enum CharacterStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PlatformConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  DISABLED
}

enum BindingStatus {
  ACTIVE
  PAUSED
}

enum ExternalIdentityStatus {
  UNVERIFIED
  VERIFIED
  REVOKED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum MemoryScopeType {
  CHARACTER_GLOBAL
  USER_PRIVATE
  EXTERNAL_IDENTITY
}

enum MemoryCategory {
  FACT
  PREFERENCE
  RELATIONSHIP
  COMMITMENT
  GOAL
  EVENT
  SUMMARY
  OTHER
}

enum MemoryItemStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
  INVALIDATED
  TRASHED
}

/// 人工对「重新提炼提出的长期记忆变化」的处置结果。
enum MemoryReviewDecision {
  ACCEPTED
  IGNORED
}

enum SnapshotKind {
  AUTOMATIC
  MANUAL
}

/// 忆泡的状态。忆泡是「发生过什么」的事实记录，只追加，不做状态机式替代；
/// ARCHIVED 只表示被压缩归档（例如并进阶段总结），仍可回溯。
enum MemoryEventStatus {
  ACTIVE
  ARCHIVED
}

/// 忆泡「还在长」还是「已收口」。
///
/// DRAFT：当天还在累积，新消息会继续往里加；FINAL：昨天已收口，不再改动。
/// 查询不区分两者 —— 「今天做了什么」查 DRAFT，「前天」查 FINAL，同一张表。
enum MemoryEventState {
  DRAFT
  FINAL
}

enum SnapshotStatus {
  CURRENT
  SUPERSEDED
}

enum SnapshotSourceType {
  MESSAGE
  MEMORY_ITEM
  PLATFORM_EVENT
  EXTERNAL_REFERENCE
}

enum MemorySettingsChangePolicy {
  NEXT_CYCLE
  IMMEDIATE_RECALC
}

enum MemoryJobType {
  GENERATE_SNAPSHOT
  REGENERATE_SNAPSHOT
  UPDATE_LONG_TERM_MEMORY
  CLEAN_EXPIRED_MESSAGES
  /// 按天整理忆泡：和 8 天周期无关，昨天的对话第二天就该查得到。
  EXTRACT_EVENTS
}

enum MemoryJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  RETRY_WAIT
  CANCELLED
}

enum AuditActorType {
  USER
  SYSTEM
  WORKER
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  username           String             @unique @db.VarChar(100)
  email              String?            @unique @db.VarChar(255)
  registrationIpHash String?            @db.VarChar(64)
  passwordHash       String             @db.VarChar(255)
  displayName        String?            @db.VarChar(120)
  status             UserStatus         @default(ACTIVE)
  role               UserRole           @default(USER)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  ownedCharacters    Character[]        @relation("CharacterOwner")
  linkedIdentities   ExternalIdentity[] @relation("IdentityLinkedUser")
  memoryScopes       MemoryScope[]      @relation("MemoryScopeUser")
  auditLogs          AuditLog[]         @relation("AuditActor")
  sessions           Session[]          @relation("UserSessions")

  @@map("users")
}

model Character {
  id               String                    @id @default(uuid()) @db.Uuid
  ownerId          String                    @db.Uuid
  name             String                    @db.VarChar(100)
  avatar           String?
  basePrompt       String                    @db.Text
  /// 对话示例：只用来对齐语气和用词。聊天与 QQ/B站 被动回复会注入，B站 值班判断不注入。
  styleExamples    String                    @default("") @db.Text
  /// 角色在这个对话里怎么称呼用户（默认「主人」）。空字符串 = 不特意称呼。
  userAddress      String                    @default("主人") @db.VarChar(40)
  modelConfig      Json                      @default("{}") @db.JsonB
  status           CharacterStatus           @default(ACTIVE)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(6)
  owner            User                      @relation("CharacterOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  channelBindings  CharacterChannelBinding[]
  conversations    Conversation[]
  memoryScopes     MemoryScope[]
  memorySetting    CharacterMemorySetting?
  auditLogs        AuditLog[]                @relation("CharacterAuditLogs")
  proactiveIntents ProactiveIntent[]
  stickers         CharacterSticker[]
  catchphrases     CharacterCatchphrase[]

  @@index([ownerId, status])
  @@index([updatedAt])
  @@map("characters")
}

model PlatformConnection {
  id                    String                    @id @default(uuid()) @db.Uuid
  platform              String                    @db.VarChar(50)
  displayName           String                    @db.VarChar(120)
  platformAccountKey    String?                   @db.VarChar(255)
  status                PlatformConnectionStatus  @default(DISCONNECTED)
  credentialsCiphertext Bytes?                    @db.ByteA
  credentialKeyId       String?                   @db.VarChar(255)
  metadata              Json?                     @db.JsonB
  lastEventAt           DateTime?                 @db.Timestamptz(6)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(6)
  characterBindings     CharacterChannelBinding[]
  externalIdentities    ExternalIdentity[]

  @@unique([platform, platformAccountKey])
  @@index([platform, status])
  @@map("platform_connections")
}

model CharacterChannelBinding {
  id               String             @id @default(uuid()) @db.Uuid
  characterId      String             @db.Uuid
  connectionId     String             @db.Uuid
  status           BindingStatus      @default(ACTIVE)
  routingKey       String?            @db.VarChar(255)
  config           Json?              @db.JsonB
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)
  character        Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  connection       PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  conversations    Conversation[]
  biliRoundReports BiliRoundReport[]
  biliSeenVideos   BiliSeenVideo[]
  biliActions      BiliAction[]

  @@unique([characterId, connectionId])
  @@index([status])
  @@map("character_channel_bindings")
}

model ExternalIdentity {
  id           String                 @id @default(uuid()) @db.Uuid
  platform     String                 @db.VarChar(50)
  platformUid  String                 @db.VarChar(255)
  displayName  String?                @db.VarChar(255)
  linkedUserId String?                @db.Uuid
  connectionId String?                @db.Uuid
  status       ExternalIdentityStatus @default(UNVERIFIED)
  verifiedAt   DateTime?              @db.Timestamptz(6)
  metadata     Json?                  @db.JsonB
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(6)
  linkedUser   User?                  @relation("IdentityLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  connection   PlatformConnection?    @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  memoryScopes MemoryScope[]

  @@unique([platform, platformUid])
  @@index([linkedUserId, status])
  @@index([connectionId])
  @@map("external_identities")
}

model MemoryScope {
  id                 String            @id @default(uuid()) @db.Uuid
  characterId        String            @db.Uuid
  scopeType          MemoryScopeType
  scopeKey           String            @unique @db.VarChar(500)
  userId             String?           @db.Uuid
  externalIdentityId String?           @db.Uuid
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)
  character          Character         @relation(fields: [characterId], references: [id], onDelete: Restrict)
  user               User?             @relation("MemoryScopeUser", fields: [userId], references: [id], onDelete: SetNull)
  externalIdentity   ExternalIdentity? @relation(fields: [externalIdentityId], references: [id], onDelete: SetNull)
  conversations      Conversation[]
  memoryItems        MemoryItem[]
  snapshots          MemorySnapshot[]
  events             MemoryEvent[]
  eventDays          MemoryEventDay[]
  jobs               MemoryJob[]

  @@index([characterId, scopeType])
  @@index([userId])
  @@index([externalIdentityId])
  @@map("memory_scopes")
}

model Conversation {
  id                     String                   @id @default(uuid()) @db.Uuid
  characterId            String                   @db.Uuid
  memoryScopeId          String                   @db.Uuid
  channelBindingId       String?                  @db.Uuid
  externalConversationId String?                  @db.VarChar(255)
  title                  String?                  @db.VarChar(255)
  status                 ConversationStatus       @default(ACTIVE)
  metadata               Json?                    @db.JsonB
  lastMessageAt          DateTime?                @db.Timestamptz(6)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(6)
  character              Character                @relation(fields: [characterId], references: [id], onDelete: Restrict)
  memoryScope            MemoryScope              @relation(fields: [memoryScopeId], references: [id], onDelete: Restrict)
  channelBinding         CharacterChannelBinding? @relation(fields: [channelBindingId], references: [id], onDelete: SetNull)
  messages               Message[]

  @@unique([channelBindingId, externalConversationId])
  @@index([characterId, updatedAt])
  @@index([memoryScopeId, updatedAt])
  @@map("conversations")
}

model Message {
  id                 String                 @id @default(uuid()) @db.Uuid
  conversationId     String                 @db.Uuid
  externalMessageId  String?                @db.VarChar(255)
  role               MessageRole
  eventType          String                 @default("message") @db.VarChar(80)
  content            String                 @db.Text
  occurredAt         DateTime               @db.Timestamptz(6)
  ingestedAt         DateTime               @default(now()) @db.Timestamptz(6)
  metadata           Json?                  @db.JsonB
  conversation       Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  snapshotSources    MemorySnapshotSource[]
  derivedMemoryItems MemoryItem[]           @relation("MemoryItemSourceMessage")
  derivedEvents      MemoryEvent[]          @relation("MemoryEventSourceMessage")

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("messages")
}

model ChatRequest {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @db.Uuid
  characterId    String   @db.Uuid
  requestKey     String   @db.Uuid
  requestHash    String?  @db.VarChar(64)
  claimToken     String   @db.Uuid
  status         String   @default("PROCESSING") @db.VarChar(20)
  conversationId String?  @db.Uuid
  response       Json?    @db.JsonB
  lastError      String?  @db.VarChar(700)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@unique([ownerId, characterId, requestKey])
  @@index([status, updatedAt])
  @@map("chat_requests")
}

model MemoryItem {
  id                String                 @id @default(uuid()) @db.Uuid
  memoryScopeId     String                 @db.Uuid
  category          MemoryCategory
  content           String                 @db.Text
  confidence        Float?
  /// 0..1 的重要度。衰减排序时加权：越高越不容易因为陈旧被丢掉。
  importance        Float                  @default(0.5)
  /// 上次被检索命中并真的注入提示词的时间。衰减优先看它，没有才回落到 updatedAt。
  lastRecalledAt    DateTime?              @db.Timestamptz(6)
  /// 被召回次数。越常用的记忆越稳，避免"总结里提过但很少被用"的条目先被挤掉。
  recallCount       Int                    @default(0)
  status            MemoryItemStatus       @default(ACTIVE)
  statusBeforeTrash MemoryItemStatus?
  deletedAt         DateTime?              @db.Timestamptz(6)
  sourceMessageId   String?                @db.Uuid
  sourceSnapshotId  String?                @db.Uuid
  dedupeKey         String?                @db.VarChar(255)
  validFrom         DateTime?              @db.Timestamptz(6)
  validTo           DateTime?              @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(6)
  memoryScope       MemoryScope            @relation(fields: [memoryScopeId], references: [id], onDelete: Cascade)
  sourceMessage     Message?               @relation("MemoryItemSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  sourceSnapshot    MemorySnapshot?        @relation("MemoryItemDerivedFromSnapshot", fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  snapshotSources   MemorySnapshotSource[] @relation("MemoryItemSnapshotSources")

  @@unique([memoryScopeId, dedupeKey])
  @@index([memoryScopeId, status, category])
  @@index([memoryScopeId, status, deletedAt])
  @@index([memoryScopeId, validTo])
  @@map("memory_items")
}

model MemorySnapshot {
  id                 String                 @id @default(uuid()) @db.Uuid
  snapshotKey        String                 @db.VarChar(500)
  memoryScopeId      String                 @db.Uuid
  kind               SnapshotKind           @default(AUTOMATIC)
  version            Int                    @default(1)
  periodStart        DateTime               @db.Timestamptz(6)
  periodEnd          DateTime               @db.Timestamptz(6)
  summary            String                 @db.Text
  structuredContent  Json                   @db.JsonB
  status             SnapshotStatus         @default(CURRENT)
  modelMetadata      Json?                  @db.JsonB
  generatedAt        DateTime?              @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  memoryScope        MemoryScope            @relation(fields: [memoryScopeId], references: [id], onDelete: Cascade)
  sources            MemorySnapshotSource[]
  derivedMemoryItems MemoryItem[]           @relation("MemoryItemDerivedFromSnapshot")
  derivedEvents      MemoryEvent[]          @relation("MemoryEventSourceSnapshot")
  reviews            MemoryReview[]
  jobs               MemoryJob[]

  @@unique([snapshotKey, version])
  @@index([memoryScopeId, periodStart, periodEnd])
  @@index([memoryScopeId, status, periodEnd])
  @@map("memory_snapshots")
}

model MemorySnapshotSource {
  id           String             @id @default(uuid()) @db.Uuid
  snapshotId   String             @db.Uuid
  sourceType   SnapshotSourceType
  sourceRef    String             @db.VarChar(500)
  messageId    String?            @db.Uuid
  memoryItemId String?            @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  snapshot     MemorySnapshot     @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  message      Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  memoryItem   MemoryItem?        @relation("MemoryItemSnapshotSources", fields: [memoryItemId], references: [id], onDelete: SetNull)

  @@unique([snapshotId, sourceType, sourceRef])
  @@index([messageId])
  @@index([memoryItemId])
  @@map("memory_snapshot_sources")
}

/// 人对某条审核建议的处置。对应快照 structuredContent.memoryChangesApplied[changeIndex]。
/// 单独存表而不回写快照：快照是不可变的审计产物，人的决定不该改它。
model MemoryReview {
  id              String               @id @default(uuid()) @db.Uuid
  snapshotId      String               @db.Uuid
  changeIndex     Int
  decision        MemoryReviewDecision
  /// 采纳后实际写入或受影响的记忆条目；忽略时为空。
  memoryItemId    String?              @db.Uuid
  /// 采纳结果：CREATED / REPLACED / INVALIDATED / DUPLICATE_IGNORED。
  outcome         String?              @db.VarChar(40)
  decidedByUserId String               @db.Uuid
  decidedAt       DateTime             @default(now()) @db.Timestamptz(6)
  snapshot        MemorySnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, changeIndex])
  @@index([snapshotId, decision])
  @@map("memory_reviews")
}

model CharacterMemorySetting {
  id                          String                     @id @default(uuid()) @db.Uuid
  characterId                 String                     @unique @db.Uuid
  snapshotIntervalDays        Int                        @default(8)
  pendingSnapshotIntervalDays Int?
  timezone                    String                     @default("Asia/Shanghai") @db.VarChar(100)
  anchorAt                    DateTime                   @default(now()) @db.Timestamptz(6)
  nextSnapshotAt              DateTime?                  @db.Timestamptz(6)
  autoSnapshotEnabled         Boolean                    @default(true)
  changePolicy                MemorySettingsChangePolicy @default(NEXT_CYCLE)
  rawMessageRetentionDays     Int?
  rawMessageCleanupEnabled    Boolean                    @default(false)
  createdAt                   DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                   @updatedAt @db.Timestamptz(6)
  character                   Character                  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_memory_settings")
}

model MemoryJob {
  id             String          @id @default(uuid()) @db.Uuid
  memoryScopeId  String          @db.Uuid
  snapshotId     String?         @db.Uuid
  type           MemoryJobType
  idempotencyKey String          @unique @db.VarChar(500)
  periodStart    DateTime?       @db.Timestamptz(6)
  periodEnd      DateTime?       @db.Timestamptz(6)
  status         MemoryJobStatus @default(QUEUED)
  attemptCount   Int             @default(0)
  maxAttempts    Int             @default(3)
  runAt          DateTime        @default(now()) @db.Timestamptz(6)
  lockedAt       DateTime?       @db.Timestamptz(6)
  lockedBy       String?         @db.VarChar(255)
  lastError      String?         @db.Text
  startedAt      DateTime?       @db.Timestamptz(6)
  completedAt    DateTime?       @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  memoryScope    MemoryScope     @relation(fields: [memoryScopeId], references: [id], onDelete: Cascade)
  snapshot       MemorySnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([status, runAt])
  @@index([memoryScopeId, periodStart, periodEnd])
  @@map("memory_jobs")
}

/// QQ 群公告草稿。管理员在群里让角色拟稿，确认后才发布；草稿有有效期，
/// 避免几天后一句「确认发布」把过期内容发出去。
model OnebotGroupAnnouncement {
  id           String    @id @default(uuid()) @db.Uuid
  connectionId String    @db.Uuid
  groupId      String    @db.VarChar(64)
  requestedBy  String    @db.VarChar(64)
  characterId  String?   @db.Uuid
  topic        String    @db.Text
  content      String    @db.Text
  /// PENDING / PUBLISHING / PUBLISHED / FAILED / EXPIRED / CANCELLED
  status       String    @default("PENDING") @db.VarChar(20)
  error        String?   @db.Text
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime  @db.Timestamptz(6)
  publishedAt  DateTime? @db.Timestamptz(6)

  @@index([connectionId, groupId, status, createdAt], map: "onebot_group_announcements_connection_group_status_idx")
  @@map("onebot_group_announcements")
}

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  actorType   AuditActorType
  actorId     String?        @db.Uuid
  characterId String?        @db.Uuid
  action      String         @db.VarChar(120)
  entityType  String         @db.VarChar(120)
  entityId    String?        @db.VarChar(255)
  details     Json?          @db.JsonB
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  actor       User?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  character   Character?     @relation("CharacterAuditLogs", fields: [characterId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([characterId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Server-side login sessions. The browser only holds an opaque token; the database stores its
/// SHA-256 hash, so a leaked database dump cannot be replayed as a valid cookie.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(6)
  userAgent  String?   @db.VarChar(255)
  ipHash     String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Failed and successful login attempts, used for throttling. Kept in PostgreSQL so multiple
/// instances share the same view of brute-force attempts.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @db.VarChar(100)
  ipHash    String   @db.VarChar(64)
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([username, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_attempts")
}

/// B站值班：每一轮"刷B站"的报告。替代 bili-desk 的 out/<date>.md 文件级报告。
/// 报告正文用 `### BV号` 段落标记"挑中的"视频，宿主按段落数统计本轮挑了几条。
model BiliRoundReport {
  id          String                  @id @default(uuid()) @db.Uuid
  bindingId   String                  @db.Uuid
  day         String                  @db.VarChar(10)
  roundIndex  Int                     @default(1)
  pickedCount Int                     @default(0)
  content     String                  @db.Text
  createdAt   DateTime                @default(now()) @db.Timestamptz(6)
  binding     CharacterChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, day, roundIndex])
  @@index([bindingId, createdAt])
  @@map("bili_round_reports")
}

/// B站值班判重表：替代 bili-desk 的 seen.md，记录看过的每一条视频（挑中/跳过都算）。
/// 最近 7 天看过的 BV 不再重复挑，用 bvid 唯一约束保证幂等。
model BiliSeenVideo {
  id        String                  @id @default(uuid()) @db.Uuid
  bindingId String                  @db.Uuid
  bvid      String                  @db.VarChar(32)
  title     String?                 @db.VarChar(255)
  author    String?                 @db.VarChar(120)
  result    String                  @db.VarChar(20)
  reason    String?                 @db.Text
  /// 终判给这条视频打的分（0-20）。null = 这轮没打分（老记录或模型没给）。
  score     Int?
  seenAt    DateTime                @default(now()) @db.Timestamptz(6)
  binding   CharacterChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, bvid])
  @@index([bindingId, seenAt])
  @@map("bili_seen_videos")
}

/// 主动找话的「目的池」。
///
/// 目的必须落库，不能每次现编：刚聊完又凑上来、同一句话反复说，都是「每次现编」的典型症状。
/// 一条目的走完 PENDING → SENT（真发出去）/ SKIPPED（这轮放弃）/ EXPIRED（放太久失效）。
model ProactiveIntent {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @db.Uuid
  /// SHARE 分享 / ASK 索取 / INVITE 邀请 / CONFIDE 倾诉 / CURIOUS 好奇 / FOLLOWUP 追问
  kind        String    @db.VarChar(20)
  /// 一句话的目的，用她自己的口吻写。
  goal        String    @db.Text
  /// 0..1：这是不是个真目的。低置信度的存着但不挑中。
  confidence  Float     @default(0.5)
  /// 0..1：放久了会失效的（「他今天说的那个事」）该高一点。
  urgency     Float     @default(0.5)
  /// 来源：memory（长期记忆）/ chat（最近对话）。
  origin      String    @db.VarChar(20)
  /// 去重键，同一角色的同一目的短期不重复。
  dedupeKey   String    @db.VarChar(255)
  /// PENDING / SENT / SKIPPED / EXPIRED
  status      String    @default("PENDING") @db.VarChar(20)
  attempts    Int       @default(0)
  sentAt      DateTime? @db.Timestamptz(6)
  /// 真发出去的正文（发出后才有）。
  content     String?   @db.Text
  /// 发给了谁（平台 + 会话 key），排查用。
  recipient   String?   @db.VarChar(120)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, dedupeKey])
  @@index([characterId, status, createdAt])
  @@map("proactive_intents")
}

/// QQ 群里「安静了多久」的唯一事实来源。
///
/// 群消息平时不落库（她没回话的那一轮一条都不存，只有真的回复才在事务里落消息），
/// 所以「这个群多久没动静」在库里查不到；而判断这件事的 tick 是独立进程，
/// 读不到适配器内存里的 `GroupContext`，只能落一张轻表。
///
/// 没有 relation：这张表只是渠道侧的事实记录，不参与角色的级联删除语义，
/// 与 `onebot_group_announcements` 同一个处理方式。
model GroupActivity {
  id                     String    @id @default(uuid()) @db.Uuid
  channelBindingId       String    @db.Uuid
  characterId            String    @db.Uuid
  /// `g:<群号>`，与 Conversation.externalConversationId 同口径。
  externalConversationId String    @db.VarChar(255)
  groupId                String    @db.VarChar(64)
  /// 群里最后一条消息（任何人发的）的收到时刻。
  lastMessageAt          DateTime  @db.Timestamptz(6)
  /// 她最后一次在这个群说话的时刻。
  lastSpokeAt            DateTime? @db.Timestamptz(6)
  /// 她最后一次**真的**主动开了话题（页面展示用）。
  lastInitiativeAt       DateTime? @db.Timestamptz(6)
  /// 最后一次为这个群花过模型调用 —— 成功开口、模型判定不说、报错都算。
  /// 闸门的「最短间隔」看它：不然一个死群会每分钟调一次模型。
  lastAttemptAt          DateTime? @db.Timestamptz(6)
  /// 最近几条群消息当素材：[{ speaker, text, at }]，最多 12 条。
  recentLines            Json?     @db.JsonB
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([channelBindingId, externalConversationId])
  @@index([characterId, lastMessageAt])
  @@map("group_activities")
}

/// B站 的对外动作账本：收藏、发动态。
/// 记在库里而不是内存，是为了做「每天最多几次」「两条动态至少隔多久」这类判定——
/// 进程重启后内存里的计数会归零，账号那边的痕迹删不掉。
model BiliAction {
  id        String                  @id @default(uuid()) @db.Uuid
  bindingId String                  @db.Uuid
  /// 东八区日界，与值班报告的 day 同口径。
  day       String                  @db.VarChar(10)
  /// fav | dynamic
  kind      String                  @db.VarChar(20)
  bvid      String?                 @db.VarChar(32)
  /// 动作内容（动态正文 / 收藏理由），排查用。
  detail    String?                 @db.Text
  createdAt DateTime                @default(now()) @db.Timestamptz(6)
  binding   CharacterChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([bindingId, day, kind])
  @@index([bindingId, createdAt])
  @@map("bili_actions")
}

/// 每次模型调用的 token 记账。
/// 故意不做外键：账单不应该随角色/会话删除而消失，且这里只用于统计与额度。
model ModelUsage {
  id               String   @id @default(uuid()) @db.Uuid
  /// 调用类别：chat / channel / snapshot / bili-screening / bili-judge / other。
  /// 用字符串而不是 enum：新调用点不该为此再跑一次迁移。
  kind             String   @db.VarChar(40)
  model            String   @db.VarChar(120)
  characterId      String?  @db.Uuid
  userId           String?  @db.Uuid
  conversationId   String?  @db.Uuid
  channelBindingId String?  @db.Uuid
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  /// 思考型模型（如 deepseek-flash）单独统计的 reasoning token。
  reasoningTokens  Int?
  /// 缓存命中的输入 token（DeepSeek 的 prompt_cache_hit_tokens / OpenAI 的 cached_tokens）。
  /// null 表示这次调用没有回传缓存明细（历史数据或供应商不提供），计价只能按未命中价算。
  cacheHitTokens   Int?
  cacheMissTokens  Int?
  metadata         Json?    @db.JsonB
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  @@index([characterId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@map("model_usages")
}

/// 角色自己的表情包（贴图）：QQ 内置表情之外的「她自己的图」。
/// 图片本体存本地磁盘（.data/stickers/<角色 id>/），库里只放清单与文件名 ——
/// 二进制不该进数据库，迁移时按目录拷走即可；删角色时整目录一起删。
model CharacterSticker {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @db.Uuid
  /// 表情包的名字。**模型看到的就是它**，别写太长也别写编号。
  name        String    @db.VarChar(60)
  /// 什么时候用这张：一句话场景说明，进提示词帮她在十来张里挑对。
  usage       String    @default("") @db.Text
  /// 磁盘文件名（相对 .data/stickers/<characterId>/）。由服务端生成，
  /// 绝不取客户端传来的路径 —— 否则一个 `../` 就能写出目录之外。
  fileName    String    @db.VarChar(120)
  mimeType    String    @db.VarChar(60)
  sizeBytes   Int
  /// 关掉 = 暂时不让她用，但图留着。
  enabled     Boolean   @default(true)
  useCount    Int       @default(0)
  lastUsedAt  DateTime? @db.Timestamptz(6)
  /// 图片内容的 SHA-256，用来给「自动收图」去重：群里同一张图被转发 N 次只收一次。
  contentHash String?   @db.VarChar(64)
  /// 来源：manual（手动上传）/ collected（群里自动收的）/ qq（从 QQ 收藏夹同步下来的）。
  source      String    @default("manual") @db.VarChar(20)
  /// QQ 收藏表情的 emoji_id（形如 `<QQ号>_0_0_0_<md5>_0_0`）。
  /// 有值 = 这一行和 QQ 收藏夹里那张是同一张：改名要回写备注、删除要连 QQ 一起删。
  /// 空 = 只在本地（还没推上去，或者推失败了）。
  qqEmojiId   String?   @db.VarChar(120)
  /// QQ 图标的 md5（从 emoji_id 里拆出来的那段）。用它认「emoji_id 变了但还是同一张图」——
  /// 在 QQ 里删了又加同一张图，emoji_id 会换，md5 不变。
  qqMd5       String?   @db.VarChar(64)
  /// 回收站：非空即已删。软删而不是直接删，是因为 QQ 那边一删本地就没了，标签全白打。
  deletedAt     DateTime? @db.Timestamptz(6)
  /// 谁删的：local（在本地删的，要同步去删 QQ）/ qq（QQ 那边没了，本地跟着进回收站）。
  deletedReason String?   @db.VarChar(20)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, qqEmojiId])
  @@index([characterId, enabled])
  @@index([characterId, deletedAt])
  @@map("character_stickers")
}

/// 角色的梗语录：她会**原样说出来**的那几句口头禅（「xxx 不烧心吗」）。
///
/// 为什么不塞进 `styleExamples`：那段注入时带着「别把句子原样搬出来」的指令，
/// 是拿来对齐语气的；梗要的恰好是反的 —— 原封不动说出口。两者混在一起会互相抵消。
///
/// 为什么要有独立的表而不是一个长文本框：梗需要「什么时候说」才能挑对时机，
/// 需要 `enabled` 才能说腻了先关掉而不删，需要 `lastUsedAt` 才能防复读 ——
/// 一句连说两天，角色感当场就没了。这三件事长文本框都给不了。
model CharacterCatchphrase {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @db.Uuid
  /// 台词本身。模型会原样使用，所以别写「（可以换成别的说法）」这类批注。
  phrase      String    @db.VarChar(200)
  /// 什么时候说：一句话场景说明，帮模型判断当下是不是这个梗的时机。
  usage       String    @default("") @db.Text
  /// 关掉 = 暂时不说，但留着。
  enabled     Boolean   @default(true)
  /// PENDING / ACTIVE / REJECTED。
  ///
  /// 手动加的直接 ACTIVE；从群里「捡」回来的一律先 PENDING，等用户点头才进候选池 ——
  /// 梗是群体财产，冒用群里的话说错一次就很难收回，不能像表情包那样直接入库存着。
  /// REJECTED 的行**不删**：删了下一轮扫描会把它重新捡回来，等于否不掉。
  status      String    @default("ACTIVE") @db.VarChar(20)
  /// 捡回来时的依据：哪个群、原话几条、出现几次。弹窗要给人看「她凭什么觉得这是梗」。
  evidence    Json?     @db.JsonB
  useCount    Int       @default(0)
  /// 上次说的时刻。冷却靠它算 —— 这是防复读的唯一依据，别只当统计用。
  lastUsedAt  DateTime? @db.Timestamptz(6)
  /// 来源：manual（手填）/ collected（从聊天里捡的）。
  source      String    @default("manual") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, enabled])
  @@index([characterId, status])
  @@map("character_catchphrases")
}

/// 忆泡：一次「发生了什么」的最小完整记录。
///
/// 与 `MemoryItem` 的分工：忆泡是**事实**（只追加、不覆盖），长期记忆是从事实里提炼的
/// **结论**（可以被新条目替代）。混成一条会同时坏掉两件事 —— 后续总结会把「第一次见面」
/// 改掉，而按日期过滤又只能靠正则在正文里翻。
///
/// `participants` 目前存显示名（`member_1` 这类渠道代号也在内），**不是身份引用**：
/// 跨平台身份要经过验证绑定才能合并，这一层留到接入别名表时再做。查询侧只把它当
/// 关键词降级路径，不当成「同一个人」的判据。
model MemoryEvent {
  id               String             @id @default(uuid()) @db.Uuid
  memoryScopeId    String             @db.Uuid
  /// 事件发生的当地日期（角色时区）：2026-10-31。「今天/昨天」按它分组。
  dayKey           String             @db.VarChar(10)
  state            MemoryEventState   @default(DRAFT)
  /// 事件**发生**时间（不是入库时间）。周期快照里的时区换算以此为基准。
  occurredAt       DateTime           @db.Timestamptz(6)
  /// 模糊时段：上午 / 中午 / 下午 / 傍晚 / 晚上 / 深夜。null = 只知道日期。
  timeOfDay        String?            @db.VarChar(20)
  /// 时间精度：exact / part_of_day / day。别把「下午」伪造成 14:00。
  precision        String             @default("day") @db.VarChar(20)
  place            String?            @db.VarChar(200)
  /// 一句话事件，如「和小关在北海银滩游泳」。
  title            String             @db.VarChar(200)
  detail           String             @db.Text
  /// 同义/相关词，给词法检索扩展用（不上向量库时的便宜替代）。
  keywords         String[]           @default([])
  participants     String[]           @default([])
  confidence       Float?
  sourceMessageId  String?            @db.Uuid
  sourceSnapshotId String?            @db.Uuid
  /// 幂等键：同一范围同一天同一件事重复提炼时不再插一条。
  dedupeKey        String             @db.VarChar(255)
  status           MemoryEventStatus  @default(ACTIVE)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  memoryScope      MemoryScope        @relation(fields: [memoryScopeId], references: [id], onDelete: Cascade)
  sourceMessage    Message?           @relation("MemoryEventSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  sourceSnapshot   MemorySnapshot?    @relation("MemoryEventSourceSnapshot", fields: [sourceSnapshotId], references: [id], onDelete: SetNull)

  @@unique([memoryScopeId, dedupeKey])
  @@index([memoryScopeId, occurredAt])
  @@index([memoryScopeId, status, occurredAt])
  @@index([memoryScopeId, dayKey])
  @@map("memory_events")
}

/// 某一天忆泡的整理进度。
///
/// 存在的理由有两个：① 幂等 —— 一天只做几次增量抽取，`extractedAt` 之后的消息才是新料；
/// ② 状态 —— DRAFT 表示这一天还在长，FINAL 表示已经收口、不再追加。
model MemoryEventDay {
  id            String           @id @default(uuid()) @db.Uuid
  memoryScopeId String           @db.Uuid
  dayKey        String           @db.VarChar(10)
  state         MemoryEventState @default(DRAFT)
  eventCount    Int              @default(0)
  /// 上次抽取到哪一刻；下一次只处理这之后的新消息，避免每小时都把一整天重跑一遍。
  extractedAt   DateTime?        @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
  memoryScope   MemoryScope      @relation(fields: [memoryScopeId], references: [id], onDelete: Cascade)

  @@unique([memoryScopeId, dayKey])
  @@index([memoryScopeId, state])
  @@map("memory_event_days")
}
